# Boot-time configuration. Runtime/business settings live in the console.
# See docs/concepts/architecture.md

# Leave empty for local development and suco dev runs a PostgreSQL for you.
DATABASE_URL=
BASE_URL=http://localhost:8080
HTTP_PORT=8080

# Generate with: openssl rand -hex 32
SECRET_KEY=

DEFAULT_NETWORK=
RPC_ENDPOINTS=

LOG_LEVEL=info
